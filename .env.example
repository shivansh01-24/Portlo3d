# OpenRouter API Key (Server-Side Only - NEVER expose to client)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter Free Models (Ordered Priority Fallback: Free -> Free -> Free)
OPENROUTER_PRIMARY_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_FALLBACK_MODEL_1=google/gemini-2.0-flash-exp:free
OPENROUTER_FALLBACK_MODEL_2=deepseek/deepseek-chat:free
PORT=3000
