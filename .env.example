# OpenRouter API Key (Server-Side Only - NEVER expose to client)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter Free Models (Ordered Priority Fallback: Free -> Free -> Free)
OPENROUTER_PRIMARY_MODEL=google/gemma-4-31b-it:free
OPENROUTER_FALLBACK_MODEL_1=google/gemma-4-26b-a4b-it:free
OPENROUTER_FALLBACK_MODEL_2=nvidia/nemotron-3-super-120b-a12b:free
PORT=3000
